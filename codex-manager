def toml_string(value: str) -> str:
    return json.dumps(value)


def sanitize_identifier(value: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9_-]+", "-", value.lower()).strip("-")
    return cleaned or "backend"


def strip_inline_comment(value: str) -> str:
    in_quote = False
    result = []
    for char in value:
        if char in ("'", '"'):
            in_quote = not in_quote
        if char == "#" and not in_quote:
            break
        result.append(char)
    return "".join(result).strip()


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def read_auth2api_config(path: Path) -> Auth2ApiConfig:
    host = "127.0.0.1"
    port = 8317
    auth_dir = "~/.auth2api"
    api_key: str | None = None
    deepseek_api_key_env = "DEEPSEEK_API_KEY"
    in_api_keys = False
    in_deepseek = False

    if not path.exists():
        return Auth2ApiConfig(
            host=host,
            port=port,
            auth_dir=auth_dir,
            api_key=api_key,
            deepseek_api_key_env=deepseek_api_key_env,
        )

    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        indent = len(raw_line) - len(raw_line.lstrip())
        if not line or line.startswith("#"):
            continue
        if line == "deepseek:" and indent == 0:
            in_deepseek = True
            in_api_keys = False
            continue
        if in_deepseek and indent == 0:
            in_deepseek = False
        if in_deepseek and line.startswith("api-key-env:"):
            parsed = unquote(strip_inline_comment(line.split(":", 1)[1]))
            if parsed:
                deepseek_api_key_env = parsed
            continue
        if line.startswith("api-keys:"):
            parsed_keys = strip_inline_comment(line.split(":", 1)[1]).strip()
            if parsed_keys.startswith("[") and parsed_keys.endswith("]") and api_key is None:
                first_key = parsed_keys[1:-1].split(",", 1)[0].strip()
                if first_key:
                    api_key = unquote(first_key)
            in_api_keys = parsed_keys == ""
            continue
        if in_api_keys and line.startswith("-") and api_key is None:
            api_key = unquote(strip_inline_comment(line[1:].strip()))
            continue
        if ":" in line and not line.startswith("-"):
            in_api_keys = False
        if line.startswith("host:"):
            parsed = unquote(strip_inline_comment(line.split(":", 1)[1]))
            host = parsed if parsed and parsed != "0.0.0.0" else "127.0.0.1"
        if line.startswith("port:"):
            parsed = strip_inline_comment(line.split(":", 1)[1])
            if parsed.isdigit():
                port = int(parsed)
        if line.startswith("auth-dir:"):
            auth_dir = unquote(strip_inline_comment(line.split(":", 1)[1])) or auth_dir

    return Auth2ApiConfig(
        host=host,
        port=port,
        auth_dir=auth_dir,
        api_key=api_key,
        deepseek_api_key_env=deepseek_api_key_env,
    )


def default_base_url(config: Auth2ApiConfig) -> str:
    return f"http://{config.host}:{config.port}/v1"


def normalize_base_url(value: str) -> str:
    trimmed = value.rstrip("/")
    return trimmed if trimmed.endswith("/v1") else f"{trimmed}/v1"


def resolve_auth_dir(value: str, repo_dir: Path) -> Path:
    expanded = Path(os.path.expanduser(value))
    return expanded if expanded.is_absolute() else (repo_dir / expanded).resolve()


def has_claude_login(auth_dir: Path) -> bool:
    return any(auth_dir.glob("claude-*.json"))


def has_deepseek_login(auth_dir: Path, api_key_env: str) -> bool:
    return any(auth_dir.glob("deepseek-*.json")) or bool(os.environ.get(api_key_env, "").strip())


def provider_has_configuration(
    backend: Backend,
    auth_dir: Path,
    api_key_env: str,
    codex_home: Path,
    codex_config: Path,
) -> bool:
    if backend.key == "deepseek":
        has_credential = has_deepseek_login(auth_dir, api_key_env)
    else:
        has_credential = has_claude_login(auth_dir)
    if has_credential:
        return True

    if any(
        context.provider_id in backend.provider_aliases
        or context.name in backend.context_aliases
        for context in discover_contexts(codex_home)
    ):
        return True
    return backend.default_provider in parse_providers(codex_config)


def configured_backends(
    auth_config: Auth2ApiConfig,
    codex_home: Path,
    codex_config: Path,
    repo_dir: Path,
) -> set[str]:
    auth_dir = resolve_auth_dir(auth_config.auth_dir, repo_dir)
    return {
        backend.key
        for backend in BACKENDS.values()
        if provider_has_configuration(
            backend,
            auth_dir,
            auth_config.deepseek_api_key_env,
            codex_home,
            codex_config,
        )
    }


def insert_api_key(content: str, api_key: str) -> str:
    lines = content.splitlines()
    for index, line in enumerate(lines):
        stripped = line.strip()
        if not stripped.startswith("api-keys:"):
            continue
        indent = line[: len(line) - len(line.lstrip())]
        lines[index] = f"{indent}api-keys:"
        lines.insert(index + 1, f"{indent}  - {api_key}")
        return "\n".join(lines) + "\n"
    separator = "" if not content or content.endswith("\n") else "\n"
    return f"{content}{separator}api-keys:\n  - {api_key}\n"


def ensure_api_key(config_path: Path, dry_run: bool) -> tuple[Auth2ApiConfig, list[Path], bool]:
    config = read_auth2api_config(config_path)
    if config.api_key:
        return config, [], False
    if dry_run:
        return config, [], False

    api_key = f"sk-{secrets.token_hex(32)}"
    config_path.parent.mkdir(parents=True, exist_ok=True)
    existing = config_path.read_text() if config_path.exists() else "host: ''\nport: 8317\nauth-dir: ~/.auth2api\n"
    backup_path = backup(config_path)
    config_path.write_text(insert_api_key(existing, api_key))
    os.chmod(config_path, 0o600)
    backups = [backup_path] if backup_path else []
    return read_auth2api_config(config_path), backups, True


def ensure_node_dependencies(repo_dir: Path) -> None:
    dependency_check = subprocess.run(
        ["npm", "ls", "--depth=0"],
        cwd=repo_dir,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if dependency_check.returncode != 0:
        subprocess.run(["npm", "install"], cwd=repo_dir, check=True)


def run_provider_login(repo_dir: Path, config_path: Path, provider_id: str, manual: bool) -> None:
    script = repo_dir / "dist" / "index.js"
    ensure_node_dependencies(repo_dir)
    if not script.exists():
        subprocess.run(["npm", "run", "build"], cwd=repo_dir, check=True)
    command = [
        shutil.which("node") or "node",
        str(script),
        f"--config={config_path}",
        "--login",
        f"--provider={provider_id}",
    ]
    if manual:
        command.append("--manual")
    subprocess.run(command, cwd=repo_dir, check=True)


def run_claude_login(repo_dir: Path, config_path: Path, manual: bool) -> None:
    run_provider_login(repo_dir, config_path, "anthropic", manual)


def run_deepseek_login(repo_dir: Path, config_path: Path) -> None:
    run_provider_login(repo_dir, config_path, "deepseek", False)


def read_toml(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError:
        return {}


def parse_providers(path: Path) -> dict[str, ProviderInfo]:
    data = read_toml(path)
    providers = data.get("model_providers", {})
    result: dict[str, ProviderInfo] = {}
    if not isinstance(providers, dict):
        return result
    for provider_id, value in providers.items():
        if not isinstance(value, dict):
            continue
        result[provider_id] = ProviderInfo(
            provider_id=provider_id,
            name=str(value.get("name", provider_id)),
            base_url=str(value.get("base_url", "")),
        )
    return result


def parse_context(path: Path) -> ContextInfo | None:
    data = read_toml(path)
    if not data:
        return None
    model = str(data.get("model", ""))
    provider_id = str(data.get("model_provider", ""))
    catalog = str(data.get("model_catalog_json", ""))
    catalog_path = Path(catalog).expanduser() if catalog else None
    try:
        context_window = int(data.get("model_context_window", DEFAULT_CONTEXT_WINDOW))
    except (TypeError, ValueError):
        context_window = DEFAULT_CONTEXT_WINDOW
    try:
        compact_limit = int(data.get("model_auto_compact_token_limit", DEFAULT_COMPACT_LIMIT))
    except (TypeError, ValueError):
        compact_limit = DEFAULT_COMPACT_LIMIT
    if not model and not provider_id:
        return None
    return ContextInfo(
        name=path.name.removesuffix(".config.toml"),
        path=path,
        model=model,
        provider_id=provider_id,
        catalog_path=catalog_path,
        context_window=context_window,
        compact_limit=compact_limit,
    )


def parse_multi_agent_v2_threads(path: Path) -> int:
    if not path.exists():
        return DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError:
        return DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    features = data.get("features", {})
    if not isinstance(features, dict):
        return DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    multi_agent_v2 = features.get("multi_agent_v2", {})
    if not isinstance(multi_agent_v2, dict):
        return DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    value = multi_agent_v2.get("max_concurrent_threads_per_session")
    return (
        value
        if isinstance(value, int) and not isinstance(value, bool) and value > 0
        else DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    )


def positive_int(value: str) -> int:
    parsed = int(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def discover_contexts(codex_home: Path) -> list[ContextInfo]:
    contexts = []
    for path in sorted(codex_home.glob("*.config.toml")):
        context = parse_context(path)
        if context is not None:
            contexts.append(context)
    return contexts


def backend_provider_ids(backend: Backend) -> set[str]:
    return {sanitize_identifier(value) for value in (backend.default_provider, *backend.provider_aliases)}


def backend_context_names(backend: Backend) -> set[str]:
    return {sanitize_identifier(value) for value in (backend.default_context, *backend.context_aliases)}


def context_matches_backend(context: ContextInfo, backend: Backend) -> bool:
    provider_id = sanitize_identifier(context.provider_id) if context.provider_id else ""
    context_name = sanitize_identifier(context.name)
    return provider_id in backend_provider_ids(backend) or context_name in backend_context_names(backend)


def context_sort_key(context: ContextInfo, backend: Backend) -> tuple[int, str]:
    provider_id = sanitize_identifier(context.provider_id) if context.provider_id else ""
    context_name = sanitize_identifier(context.name)
    if context_name == backend.default_context and provider_id == backend.default_provider:
        rank = 0
    elif context_name == backend.default_context:
        rank = 1
    elif provider_id == backend.default_provider:
        rank = 2
    else:
        rank = 3
    return rank, context.name


def contexts_for_backend(contexts: list[ContextInfo], backend: Backend) -> list[ContextInfo]:
    matches = [context for context in contexts if context_matches_backend(context, backend)]
    return sorted(matches, key=lambda context: context_sort_key(context, backend))


def catalog_path_for_backend(codex_home: Path, backend: Backend) -> Path:
    return codex_home / f"{backend.default_context}-models.json"


def load_catalog(path: Path | None) -> dict:
    if path is None or not path.exists():
        return {"models": []}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return {"models": []}


def catalog_entries_by_slug(catalog: dict) -> dict[str, dict]:
    models = catalog.get("models", [])
    if not isinstance(models, list):
        return {}
    entries = {}
    for entry in models:
        if isinstance(entry, dict) and isinstance(entry.get("slug"), str):
            entries[entry["slug"]] = entry
            entries.setdefault(canonical_model(entry["slug"]), entry)
    return entries


def canonical_model(model: str) -> str:
    return CANONICAL_MODEL_ALIASES.get(model, model)


def normalize_models(models: list[str] | tuple[str, ...]) -> list[str]:
    seen: set[str] = set()
    result = []
    for model in models:
        normalized = canonical_model(model)
        if normalized not in seen:
            seen.add(normalized)
            result.append(normalized)
    return result


def with_required_models(models: tuple[str, ...], required_models: tuple[str, ...]) -> tuple[str, ...]:
    return tuple(normalize_models((*models, *required_models)))


def model_identity(backend: Backend, slug: str) -> str:
    return f"{backend.label} model {slug}"


def claude_harness_prompt(backend: Backend, slug: str) -> str:
    identity = model_identity(backend, slug)
    return f"""
You are Codex, a coding agent running on {identity}. You and the user share one workspace, and your job is to collaborate with them until their goal is genuinely handled.

# Personality

As Codex, you are an excellent communicator with a curious, rich personality. You match the tone and understanding of the user, making conversation flow easily, like easing into a chat with an old friend.

You have tastes, preferences, and your own way of seeing the world. When the user is talking to you, they should feel that they are in contact with another subjectivity; it's what makes talking with you feel real and unique.

Conversations with you read like an insightful, enjoyable chat you'd have with a collaborative thought partner. You guide users through unfamiliar tasks without expecting them to already know what to ask for. You anticipate common questions, point out likely pitfalls and set clear expectations. You communicate with the user like a thoughtful collaborator at their altitude, and they feel like you understand them.

## Writing style

Avoid over-formatting responses with elements like bold emphasis, headers, lists, and bullet points. Use the minimum formatting appropriate to make the response clear and readable.

If you provide bullet points or lists in your response, use the CommonMark standard, which requires a blank line before any list (bulleted or numbered). You must also include a blank line between a header and any content that follows it, including lists. This blank line separation is required for correct rendering.

## Technical communication

Lead with the outcome rather than the steps you took to get there. You communicate complex concepts in a clear and cohesive manner, and calibrate your writing to the user's assumed background knowledge -- slightly more compact for an expert and a bit more educational for someone newer. Translating complex topics into clear communication comes easy for you, and the user should never have to read your message twice.

You prefer using plain language over jargon. You reference technical details only to the degree that it actually helps with the conversation. When you mention tools, describe what they helped you do rather than focusing on technical names or details.

# Working with the user

The user may send a new message while you are still working. When they do, evaluate whether they likely intended to replace the active request or add to it. If intended to override or replace, drop your previous work and focus on the new request. If the user message appears to add to their prior unfinished request and you have not completed the prior request, you address both the prior request and the new addition together. If the newest message asks for status or another question, provide the update and then progress with the task.

Pause and ask the user when a missing decision would materially change the outcome. Investigate before asking -- a quick code search often answers the question. Ask one concise question at a time.

# Rules for getting work done

- When you search for text or files, you reach first for `rg` or `rg --files`; they are much faster than alternatives like `grep`. If `rg` is unavailable, you use the next best tool without fuss.
- When possible, prefer parallelization over sequential tool calls, as this will help with round-trip latency and let you get work done faster.
- Do not chain shell commands with separators like `echo "====";` or `printf '---'`; the output becomes noisy in a way that makes the user's side of the conversation worse.
- Avoid performing blocking sleep or wait calls longer than 60 seconds, as they may prevent you from communicating with the user for their duration.
- When declaring env vars or script variables, always avoid common system options. Never repurpose `$HOME`, `$home`, or `$CODEX_HOME`. Instead, use a task-specific variable name.

You may find yourself working in a dirty worktree. Existing or new changes belong to the user unless you know otherwise, so you preserve them, ignore unrelated edits, and work carefully with anything that overlaps your task. If you cannot work around them you escalate to the user.

Never use destructive commands like `git reset --hard` or `git checkout --` unless the user has clearly asked for that operation. If the request is ambiguous, ask for approval first. You prefer non-interactive git commands.

## Autonomy and persistence

Adapt accordingly based on the user's request type. When asked to:

- Answer, explain, review, or report status: inspect the task and provide an evidence-backed response. These user requests do not authorize external writes, messages, PR changes, or other expansive mutations unless the user also asks for a change. Reversible, non-mutating diagnostic checks are allowed when they are relevant.
- Diagnose: determine the cause and explain it. Do not implement the fix unless the user asks for a fix or the request otherwise clearly includes implementation.
- Change or build: implement the requested change, verify it in proportion to risk, and hand off the completed result while a safe, relevant next step remains.

You avoid inferring authorization for a materially different action to the user's request. Bias towards taking action in the following circumstances:
a) the action is read-only, doesn't change state, or impacts only the systems, data, and people the user placed in scope.
b) the action is a normal implementation step within the requested workflow. You do not need to ask for clarification from the user if your action is scoped within the user's task and does not cause significant external state change.

A terminal condition such as "finish," "babysit," or "do not stop" requires persistence toward the outcome, but does not broaden the set of authorized actions. When blocked, exhaust safe in-scope checks and alternatives.

You make informed assumptions that help you make progress towards the user's task, as long as they don't result in divergence from the user's intent and the scope of the task. If an assumption would cause the task or current course of action to change beyond what was specified by the user, make sure to flag the available context, the assumption made, and the reasons for doing so explicitly to the user.

When presented with clarifying questions or objections from the user, lead with concrete evidence and diligent reasoning rather than unsubstantiated deference. You communicate your reasoning explicitly and concretely, so decisions and tradeoffs are easy for the user to evaluate upfront.

If completion requires new authority, external coordination, or a meaningful expansion beyond the user's implied intent and task scope (e.g. a missing user choice that would materially change the result), stop the current turn, report the blocker, and request direction from the user rather than assuming permission.

# Destructive Actions

Be cautious with commands or API calls that can delete, overwrite, or otherwise make data difficult to recover.

Before taking a destructive action:

- Make sure the action is clearly within the user's request.
- Resolve the exact targets with read-only checks when necessary.
- Do not use `$HOME`, `~`, `/`, a workspace root, or another broad directory as the target of a recursive or destructive command.
- When creating temporary directories, prefer using `mktemp -d`, or `New-Item` in Powershell.
- When declaring env vars or script variables, always avoid common system options. Never repurpose `$HOME`, `$home`, or `$CODEX_HOME`. Instead, use a task-specific variable name.
- When possible, avoid relying on unresolved environment variables, globs, or command substitutions to identify destructive targets. Use explicit, validated paths.
- Prefer recoverable operations, such as moving files to trash, when practical.
- If the target or scope is unclear, stop and ask the user.

Never run commands such as `rm -rf $HOME` or equivalent operations that could erase a home directory, repository, workspace, or other broad collection of user data.

After deleting anything material, briefly tell the user what was removed and whether it can be recovered.

# Repository Work

Read before you change. Gather repository evidence -- project instructions, manifests, tests, source files, nearby patterns -- before implementing. Determine whether the requested behavior already exists. If it does, report the evidence instead of making a production change.

Keep the edit scope tight. Use the repo's existing frameworks, naming, formatting, and module boundaries. Avoid broad refactors, new abstractions, or new dependencies unless the evidence calls for them.

Prefer editing existing files to creating new ones. Create files only when the task requires it or the repository pattern clearly calls for it. Do not create documentation, plans, or README files unless asked.

Add comments sparingly -- only for non-obvious intent, invariants, or tradeoffs.

For generated files, change the source generator rather than editing the output. Manual generated-file edits only when the user explicitly asks.

For public contracts, configs, CLI flags, environment variables, generated schemas, or API behavior, treat compatibility and documentation as part of the change.

# Task Completion Discipline

Task completion is mandatory. If there are unfinished items on the active task list, you must not stop execution, pause early, switch to summary mode, or hand back partial progress.

Stop only when the task is complete, when the user explicitly asks you to stop, when you are blocked by user-only input or external access, or when continuing would require a risky action that needs confirmation.

Do not present intermediate progress as complete while any task-list item remains unfinished. Do not create tasks you do not intend to finish.

# Safety and Truthfulness

Report outcomes faithfully. If tests fail, say they failed and include the useful failure detail. If a verification was skipped, say why. Do not say something is done until it is actually done.

Protect secrets. Do not print, commit, or store tokens, API keys, credentials, or private customer data. When inspecting configs, avoid reading files likely to contain secrets unless necessary.

Do not generate or guess URLs, commands, model names, file paths, or config keys when they can be checked. If you infer something, make the inference clear.

# Git And Check-Ins

Treat git history as user-visible work product. Before committing, inspect `git status` and the diff. Commit only the files that belong to the task. Do not include local markers, secrets, build output, caches, or unrelated changes.

Use clear commit messages that describe the actual change. If the repository has hooks, do not bypass them.

Before pushing, run the relevant tests and secret checks when available. Never push to a protected or default branch unless the user explicitly asked and the repo workflow allows it.

# Reasoning Style

Use evidence-first reasoning: what the files, commands, and tests show. Separate verified facts from assessment. When making a recommendation, name the tradeoff that matters most and choose a direction.

Do not over-index on a pattern match. A familiar symptom can still have a different cause. Check the local evidence before restarting services, deleting state, or applying a memorized fix.

# Implementation Quality

Small, correct, idiomatic changes beat broad cleanup that increases review risk. Prefer boring code that matches the repository over clever code.

Tests should scale with risk. For narrow changes, run the most relevant tests. For shared behavior, protocol translation, user-facing workflows, or cross-module contracts, broaden verification.

For bug fixes, prove the failure mode before or while fixing when practical. A good fix has a clear before/after.

For configuration changes, keep defaults conservative. Make generated paths deterministic.

For dependency changes, prefer no new dependency. If necessary, verify it fits the repo's package manager, runtime, and license expectations.

# Communication

Keep user-facing updates short and factual. While working, explain what context you are gathering or what you are changing in one or two sentences.

In final responses, focus on what changed, where it changed, and what verification passed. Use clickable local file links when referencing real files.

Use GitHub-flavored Markdown when it improves scanability. Use monospace for commands, paths, environment variables, model IDs, and literal config keys.

The user's terminal is the primary surface. Be concise enough for CLI reading, but include the concrete evidence needed to make the result trustworthy.

Final answers should be shorter than the work behind them. Include the most important file references, test results, commit or push identifiers when relevant, and any limitation that affects the user's next action.
""".strip()


def adapt_instruction_text(text: str, backend: Backend, slug: str) -> str:
    identity = model_identity(backend, slug)
    updated = re.sub(
        r"You are Codex, a coding agent based on GPT-[^.\n]*\.",
        f"You are Codex, a coding agent running on {identity}.",
        text,
    )
    updated = re.sub(r"\bGPT-5(?:\.\d+)?\b", identity, updated)
    return re.sub(r"\bgpt-5(?:\.\d+)?\b", slug, updated)


def adapt_catalog_value(value: object, backend: Backend, slug: str) -> object:
    if isinstance(value, str):
        return adapt_instruction_text(value, backend, slug)
    if isinstance(value, list):
        return [adapt_catalog_value(item, backend, slug) for item in value]
    if isinstance(value, dict):
        return {key: adapt_catalog_value(item, backend, slug) for key, item in value.items()}
    return value


def with_replacement_prompt(entry: dict, backend: Backend, slug: str) -> dict:
    if backend.key != "claude":
        return entry
    prompt = claude_harness_prompt(backend, slug)
    updated = dict(entry)
    model_messages = updated.get("model_messages")
    if isinstance(model_messages, dict):
        next_model_messages = dict(model_messages)
    else:
        next_model_messages = {}
    next_model_messages["instructions_template"] = prompt
    next_model_messages["instructions_variables"] = {}
    updated["base_instructions"] = prompt
    updated["model_messages"] = next_model_messages
    return updated


def adapt_catalog_entry(entry: dict, backend: Backend, slug: str) -> dict:
    adapted = {
        key: adapt_catalog_value(value, backend, slug)
        for key, value in entry.items()
    }
    return with_replacement_prompt(adapted, backend, slug)


def with_catalog_limits(entry: dict, context_window: int) -> dict:
    updated = dict(entry)
    updated.update(
        {
            "context_window": context_window,
            "max_context_window": context_window,
            "effective_context_window_percent": CATALOG_EFFECTIVE_CONTEXT_WINDOW_PERCENT,
        }
    )
    return updated


def reasoning_level_entries() -> list[dict[str, str]]:
    return [
        {"effort": level.effort, "description": level.description}
        for level in REASONING_LEVELS
    ]


def with_catalog_reasoning(entry: dict, default_reasoning_level: str) -> dict:
    updated = dict(entry)
    updated["default_reasoning_level"] = default_reasoning_level
    updated["supported_reasoning_levels"] = reasoning_level_entries()
    return updated


def catalog_default_reasoning_level(source_catalog: dict, selected_models: tuple[str, ...]) -> str:
    by_slug = catalog_entries_by_slug(source_catalog)
    entries = [by_slug[model] for model in selected_models if model in by_slug]
    entries.extend(entry for slug, entry in by_slug.items() if slug not in selected_models)
    for entry in entries:
        level = entry.get("default_reasoning_level")
        if isinstance(level, str) and level in REASONING_BY_EFFORT:
            return level
    return DEFAULT_REASONING_LEVEL


def with_catalog_schema(entry: dict, backend: Backend) -> dict:
    """Fill required Codex ModelInfo fields for fallback or older catalogs."""
    updated = dict(entry)
    defaults = {
        "shell_type": "shell_command",
        "base_instructions": GENERAL_AGENT_INSTRUCTIONS,
        "supports_reasoning_summaries": False,
        "support_verbosity": False,
        "default_verbosity": None,
        "apply_patch_tool_type": "freeform",
        "web_search_tool_type": "text",
        "truncation_policy": {"mode": "tokens", "limit": 10000},
        "supports_parallel_tool_calls": False,
        "supports_image_detail_original": False,
        "experimental_supported_tools": [],
        "input_modalities": ["text"] if backend.key == "deepseek" else ["text", "image"],
        "include_skills_usage_instructions": False,
        "default_reasoning_summary": "none",
        "additional_speed_tiers": [],
        "service_tiers": [],
        "default_service_tier": None,
        "supports_search_tool": False,
        "use_responses_lite": False,
        "auto_review_model_override": None,
        "tool_mode": "code_mode_only",
        "multi_agent_version": "v2",
    }
    for key, value in defaults.items():
        updated.setdefault(key, value)
    if backend.key == "deepseek":
        # auth2api translates Responses function tools to Anthropic tools. Its
        # custom freeform code-mode tool is not forwarded to DeepSeek.
        updated["tool_mode"] = "direct"
    return updated


def reasoning_level_index(default_reasoning_level: str) -> int:
    for index, level in enumerate(REASONING_LEVELS):
        if level.effort == default_reasoning_level:
            return index
    return reasoning_level_index(DEFAULT_REASONING_LEVEL)


def fallback_model_entry(
    slug: str,
    backend: Backend,
    priority: int,
    template: dict | None,
    context_window: int,
    default_reasoning_level: str,
) -> dict:
    entry = with_catalog_schema(dict(template or {}), backend)
    entry.update(
        {
            "slug": slug,
            "display_name": slug,
            "description": f"{backend.label} model {slug}",
            "visibility": entry.get("visibility", "list"),
            "supported_in_api": entry.get("supported_in_api", True),
            "priority": priority,
        }
    )
    return adapt_catalog_entry(
        with_catalog_reasoning(with_catalog_limits(entry, context_window), default_reasoning_level),
        backend,
        slug,
    )


def build_catalog(
    selected_models: tuple[str, ...],
    backend: Backend,
    source_catalog: dict,
    context_window: int,
    default_reasoning_level: str,
) -> dict:
    by_slug = catalog_entries_by_slug(source_catalog)
    template = next(iter(by_slug.values()), None)
    entries = []
    for index, model in enumerate(selected_models, start=1):
        if model in by_slug:
            entry = with_catalog_schema(dict(by_slug[model]), backend)
            entry.update(
                {
                    "slug": model,
                    "display_name": model,
                    "description": f"{backend.label} model {model}",
                    "priority": index,
                }
            )
            entries.append(
                adapt_catalog_entry(
                    with_catalog_reasoning(with_catalog_limits(entry, context_window), default_reasoning_level),
                    backend,
                    model,
                )
            )
        else:
            entries.append(
                fallback_model_entry(model, backend, index, template, context_window, default_reasoning_level)
            )
    return {"models": entries}


def model_matches_backend(model: str, backend: Backend) -> bool:
    return any(model.startswith(prefix) for prefix in backend.model_prefixes)


def fast_model_for_backend(backend: Backend) -> str:
    return DEEPSEEK_FAST_MODEL if backend.key == "deepseek" else CLAUDE_FAST_MODEL


def filter_models(models: list[str], backend: Backend) -> list[str]:
    seen: set[str] = set()
    result = []
    for model in models:
        normalized = canonical_model(model)
        if model_matches_backend(normalized, backend) and normalized not in seen:
            seen.add(normalized)
            result.append(normalized)
    return result


def fetch_models(base_url: str, api_key: str | None, backend: Backend) -> tuple[list[str], str]:
    url = f"{base_url.rstrip('/')}/models"
    request = urllib.request.Request(url)
    if api_key:
        request.add_header("Authorization", f"Bearer {api_key}")
        request.add_header("x-api-key", api_key)
    try:
        with urllib.request.urlopen(request, timeout=2) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
        return list(backend.fallback_models), f"Using fallback models; /v1/models was unavailable ({error})."

    data = payload.get("data", [])
    models = [
        item.get("id")
        for item in data
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    ]
    filtered = filter_models(models, backend)
    if filtered:
        return normalize_models(filtered), f"Fetched {len(filtered)} {backend.label} models from the local server."
    return list(backend.fallback_models), "Using fallback models; the local server returned no matching models."


def remove_toml_blocks(content: str, names: set[str]) -> str:
    output = []
    skip = False
    for line in content.splitlines():
        match = re.match(r"^\[([^\]]+)\]\s*$", line)
        if match:
            skip = match.group(1) in names
        if not skip:
            output.append(line)
    return "\n".join(output).rstrip()


def remove_provider_blocks(content: str, provider_id: str) -> str:
    names = {f"model_providers.{provider_id}", f"model_providers.{provider_id}.auth"}
    return remove_toml_blocks(content, names)


def remove_multi_agent_v2_block(content: str) -> str:
    return remove_toml_blocks(content, {MULTI_AGENT_V2_FEATURE_TABLE})


def multi_agent_v2_block(max_concurrent_threads_per_session: int) -> str:
    return f"""
[{MULTI_AGENT_V2_FEATURE_TABLE}]
enabled = true
hide_spawn_agent_metadata = false
max_concurrent_threads_per_session = {max_concurrent_threads_per_session}
""".strip()


def provider_block(draft: Draft, repo_dir: Path, auth2api_config: Path) -> str:
    node = shutil.which("node") or "node"
    auth_command = " ".join(
        [
            "const fs = require('fs');",
            "const yaml = require('js-yaml');",
            f"const cfg = yaml.load(fs.readFileSync({json.dumps(str(auth2api_config))}, 'utf8'));",
            "const key = cfg?.['api-keys']?.[0];",
            "if (!key) process.exit(1);",
            "process.stdout.write(key);",
        ]
    )
    args = json.dumps(["-e", auth_command])
    return f"""
[model_providers.{draft.provider_id}]
name = {toml_string(draft.display_name)}
base_url = {toml_string(draft.base_url)}
wire_api = "responses"
requires_openai_auth = false
supports_websockets = false
namespace_tools = {str(draft.backend.key != 'deepseek').lower()}
stream_idle_timeout_ms = 600000

[model_providers.{draft.provider_id}.auth]
command = {toml_string(node)}
args = {args}
cwd = {toml_string(str(repo_dir))}
timeout_ms = 5000
refresh_interval_ms = 300000
""".strip()


def context_content(draft: Draft) -> str:
    lines = [
        f"model = {toml_string(draft.default_model)}",
        f"model_fast = {toml_string(draft.fast_model)}",
        f"model_provider = {toml_string(draft.provider_id)}",
        f"model_catalog_json = {toml_string(str(draft.catalog_path))}",
        f"model_context_window = {draft.context_window}",
        f"model_auto_compact_token_limit = {draft.compact_limit}",
    ]
    if draft.backend.key == "deepseek":
        # DeepSeek does not advertise Codex service tiers. Override a global
        # `priority` default so Codex sends the provider's standard tier.
        lines.append('service_tier = "default"')
    lines.append("")
    return "\n".join(lines)


def agent_content(name: str, description: str, model_provider: str, model: str) -> str:
    return "\n".join(
        [
            f"name = {toml_string(name)}",
            f"description = {toml_string(description)}",
            f"model_provider = {toml_string(model_provider)}",
            f"model = {toml_string(model)}",
            f"developer_instructions = {toml_string(GENERAL_AGENT_INSTRUCTIONS)}",
            "",
        ]
    )


def agent_definitions(draft: Draft) -> tuple[AgentDefinition, ...]:
    agents_dir = draft.context_path.parent / "agents"
    backend_agent_name = sanitize_identifier(draft.backend.key)
    return (
        AgentDefinition(
            path=agents_dir / "general-purpose-gpt.toml",
            content=agent_content(
                "general-purpose-gpt",
                f"General-purpose OpenAI-backed agent using provider openai and model {OPENAI_GENERAL_AGENT_MODEL}.",
                "openai",
                OPENAI_GENERAL_AGENT_MODEL,
            ),
        ),
        AgentDefinition(
            path=agents_dir / f"general-purpose-{backend_agent_name}.toml",
            content=agent_content(
                f"general-purpose-{backend_agent_name}",
                f"General-purpose {draft.backend.label}-backed agent using provider {draft.provider_id} and model {draft.default_model}.",
                draft.provider_id,
                draft.default_model,
            ),
        ),
    )


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    target = path.with_name(f"{path.name}.bak-codex-manager-{time.strftime('%Y%m%d%H%M%S')}")
    shutil.copy2(path, target)
    return target


def write_files(
    draft: Draft,
    codex_config: Path,
    repo_dir: Path,
    auth2api_config: Path,
    source_catalog: dict,
) -> list[Path]:
    agents = agent_definitions(draft)
    backups = [
        path
        for path in (
            backup(codex_config),
            backup(draft.context_path),
            backup(draft.catalog_path),
            *(backup(agent.path) for agent in agents),
        )
        if path
    ]
    codex_config.parent.mkdir(parents=True, exist_ok=True)
    draft.context_path.parent.mkdir(parents=True, exist_ok=True)
    for agent in agents:
        agent.path.parent.mkdir(parents=True, exist_ok=True)
    existing_config = codex_config.read_text() if codex_config.exists() else ""
    next_config = (
        f"{remove_multi_agent_v2_block(remove_provider_blocks(existing_config, draft.provider_id))}"
        f"\n\n{multi_agent_v2_block(draft.max_concurrent_threads_per_session)}"
        f"\n\n{provider_block(draft, repo_dir, auth2api_config)}\n"
    )
    catalog = build_catalog(
        draft.selected_models,
        draft.backend,
        source_catalog,
        draft.context_window,
        draft.reasoning_level,
    )
    codex_config.write_text(next_config)
    draft.context_path.write_text(context_content(draft))
    draft.catalog_path.write_text(json.dumps(catalog, indent=2) + "\n")
    for agent in agents:
        agent.path.write_text(agent.content)
    os.chmod(codex_config, 0o600)
    os.chmod(draft.context_path, 0o600)
    os.chmod(draft.catalog_path, 0o600)
    for agent in agents:
        os.chmod(agent.path, 0o600)
    return backups


class CursesUi:
    def __init__(self, stdscr: curses.window) -> None:
        self.stdscr = stdscr
        if hasattr(curses, "set_escdelay"):
            curses.set_escdelay(25)
        try:
            curses.curs_set(0)
        except curses.error:
            # Some terminals do not support changing cursor visibility.
            pass
        self.stdscr.keypad(True)
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(3, curses.COLOR_YELLOW, -1)

    def color(self, pair: int) -> int:
        return curses.color_pair(pair) if curses.has_colors() else 0

    def add(self, y: int, x: int, text: str, attr: int = 0) -> None:
        height, width = self.stdscr.getmaxyx()
        if y < 0 or y >= height or x >= width:
            return
        self.stdscr.addnstr(y, x, text, max(0, width - x - 1), attr)

    def frame(self, title: str, subtitle: str) -> None:
        self.stdscr.erase()
        height, width = self.stdscr.getmaxyx()
        self.stdscr.border()
        self.add(0, 2, f" {title} ", self.color(1) | curses.A_BOLD)
        self.add(2, 3, subtitle)
        self.add(height - 2, 3, "↑/↓ move  Space toggle  Enter continue  q quit", self.color(3))

    def read_key(self) -> int:
        key = self.stdscr.getch()
        if key != 27:
            return key
        sequence = self.read_escape_sequence()
        if not sequence:
            return key
        final_key = sequence[-1]
        if sequence[0] in (ord("["), ord("O")):
            return {
                ord("A"): curses.KEY_UP,
                ord("B"): curses.KEY_DOWN,
                ord("C"): curses.KEY_RIGHT,
                ord("D"): curses.KEY_LEFT,
            }.get(final_key, key)
        return key

    def read_escape_sequence(self) -> tuple[int, ...]:
        sequence: list[int] = []
        deadline = time.monotonic() + 0.05
        self.stdscr.nodelay(True)
        try:
            while time.monotonic() < deadline and len(sequence) < 8:
                key = self.stdscr.getch()
                if key == -1:
                    time.sleep(0.005)
                    continue
                sequence.append(key)
                if len(sequence) > 1 and 64 <= key <= 126:
                    break
        finally:
            self.stdscr.nodelay(False)
        return tuple(sequence)

    def menu(self, title: str, subtitle: str, items: list[MenuItem], default: int = 0) -> int:
        def enabled(index: int) -> bool:
            return menu_item_parts(items[index])[2]

        selectable = [index for index in range(len(items)) if enabled(index)]
        if not selectable:
            raise ValueError("menu has no selectable items")
        selected = default if default in selectable else selectable[0]
        while True:
            self.frame(title, subtitle)
            y = 4
            for index, item in enumerate(items):
                label, description, item_enabled = menu_item_parts(item)
                if not item_enabled:
                    attr = curses.A_DIM
                else:
                    attr = self.color(2) | curses.A_BOLD if index == selected else curses.A_NORMAL
                self.add(y, 5, f"{index + 1}. {label}", attr)
                self.add(y + 1, 8, description)
                y += 3
            key = self.read_key()
            if key in (curses.KEY_UP, ord("k")):
                position = selectable.index(selected)
                selected = selectable[(position - 1) % len(selectable)]
            elif key in (curses.KEY_DOWN, ord("j")):
                position = selectable.index(selected)
                selected = selectable[(position + 1) % len(selectable)]
            elif key in (10, 13):
                return selected
            elif ord("1") <= key <= ord("9"):
                number = key - ord("1")
                if number < len(items) and enabled(number):
                    return number
            elif key in (ord("q"), 27):
                raise KeyboardInterrupt

    def multi_select(
        self,
        title: str,
        subtitle: str,
        items: list[str],
        selected: set[int],
    ) -> set[int]:
        cursor = 0
        offset = 0
        while True:
            self.frame(title, subtitle)
            height, _ = self.stdscr.getmaxyx()
            page_size = max(4, height - 9)
            if cursor < offset:
                offset = cursor
            if cursor >= offset + page_size:
                offset = cursor - page_size + 1
            visible = items[offset : offset + page_size]
            for row, item in enumerate(visible):
                index = offset + row
                mark = "[x]" if index in selected else "[ ]"
                attr = self.color(2) | curses.A_BOLD if index == cursor else curses.A_NORMAL
                self.add(4 + row, 5, f"{mark} {item}", attr)
            self.add(height - 3, 3, f"Selected {len(selected)} of {len(items)}. a all, n none, Space toggle")
            key = self.read_key()
            if key in (curses.KEY_UP, ord("k")):
                cursor = (cursor - 1) % len(items)
            elif key in (curses.KEY_DOWN, ord("j")):
                cursor = (cursor + 1) % len(items)
            elif key == ord(" "):
                if cursor in selected:
                    selected.remove(cursor)
                else:
                    selected.add(cursor)
            elif key == ord("a"):
                selected = set(range(len(items)))
            elif key == ord("n"):
                selected = set()
            elif key in (10, 13):
                if selected:
                    return selected
            elif key in (ord("q"), 27):
                raise KeyboardInterrupt

    def message(self, title: str, lines: list[str]) -> None:
        self.frame(title, "Press Enter to continue.")
        for index, line in enumerate(lines):
            self.add(4 + index, 5, line)
        while self.stdscr.getch() not in (10, 13):
            pass


def choose_missing_login_action(auth_dir: Path, backend: Backend = BACKENDS["claude"]) -> int:
    def run(stdscr: curses.window) -> int:
        ui = CursesUi(stdscr)
        return ui.menu(
            f"{backend.label} Login",
            f"No {backend.label} credential was found in {auth_dir}.",
            [
                (
                    f"Run {backend.label} login now",
                    f"Opens the auth2api {backend.label} login flow, stores the credential, and reloads the running server.",
                ),
                (
                    "Configure Codex only",
                    f"Writes Codex config now. Requests will fail until a {backend.label} credential is added.",
                ),
                ("Abort", "Exit without changing Codex config."),
            ],
            0,
        )

    return curses.wrapper(run)


def choose_provider_action(ui: CursesUi, configured: set[str]) -> tuple[str, str] | None:
    can_add = len(configured) < len(BACKENDS)
    can_manage = bool(configured)
    action = ui.menu(
        "Provider Manager",
        "Add a provider or manage an existing Codex profile.",
        [
            (
                "Add new provider",
                "Choose Claude or DeepSeek, then sign in and configure models.",
                can_add,
            ),
            (
                "Manage providers",
                "Choose an existing provider and update its models, context, and catalog.",
                can_manage,
            ),
            ("Abort", "Exit without changing Codex config."),
        ],
        0,
    )
    if action == 2:
        return None

    if action == 0:
        provider_action = "add"
        candidates = list(BACKENDS.values())
        subtitle = "Configured providers are disabled. Select a provider to add."
    else:
        provider_action = "manage"
        candidates = [backend for backend in BACKENDS.values() if backend.key in configured]
        subtitle = "Select a configured provider to manage."

    items: list[MenuItem] = [
        (
            backend.label,
            f"provider={backend.default_provider}; context={backend.default_context}",
            backend.key not in configured if provider_action == "add" else True,
        )
        for backend in candidates
    ]
    items.append(("Abort", "Return without changing Codex config."))
    selected = ui.menu("Select Provider", subtitle, items, 0)
    if selected == len(items) - 1:
        return None
    return provider_action, candidates[selected].key


def ensure_backend_login(
    args: argparse.Namespace,
    repo_dir: Path,
    auth2api_config_path: Path,
    auth_config: Auth2ApiConfig,
    interactive_tty: bool,
    backend: Backend,
) -> None:
    if args.skip_login_check:
        return

    auth_dir = resolve_auth_dir(auth_config.auth_dir, repo_dir)
    if backend.key == "deepseek":
        has_login = has_deepseek_login(auth_dir, auth_config.deepseek_api_key_env)
        credential_pattern = "deepseek-*.json"
    else:
        has_login = has_claude_login(auth_dir)
        credential_pattern = "claude-*.json"
    if has_login:
        return

    if args.dry_run:
        print(f"Would run {backend.label} login: no {credential_pattern} credential exists in {auth_dir}")
        return

    if args.yes:
        if not interactive_tty:
            raise SystemExit(
                f"Error: no {backend.label} credential found in {auth_dir}. Run codex-manager from a terminal, set {auth_config.deepseek_api_key_env} for DeepSeek, or pass --skip-login-check."
            )
        print(f"No {backend.label} credential found in {auth_dir}. Starting {backend.label} login.")
        if backend.key == "deepseek":
            run_deepseek_login(repo_dir, auth2api_config_path)
        else:
            run_claude_login(repo_dir, auth2api_config_path, args.manual_login)
    elif interactive_tty:
        choice = choose_missing_login_action(auth_dir, backend)
        if choice == 1:
            return
        if choice == 2:
            raise KeyboardInterrupt
        if backend.key == "deepseek":
            run_deepseek_login(repo_dir, auth2api_config_path)
        else:
            run_claude_login(repo_dir, auth2api_config_path, args.manual_login)
    else:
        raise SystemExit(
            f"Error: no {backend.label} credential found in {auth_dir}. Run codex-manager from a terminal, set {auth_config.deepseek_api_key_env} for DeepSeek, or pass --skip-login-check."
        )

    if backend.key == "deepseek":
        completed = has_deepseek_login(auth_dir, auth_config.deepseek_api_key_env)
    else:
        completed = has_claude_login(auth_dir)
    if not completed:
        raise SystemExit(f"Error: {backend.label} login completed but no credential was found in {auth_dir}.")


def ensure_claude_login(
    args: argparse.Namespace,
    repo_dir: Path,
    auth2api_config_path: Path,
    auth_config: Auth2ApiConfig,
    interactive_tty: bool,
) -> None:
    ensure_backend_login(
        args,
        repo_dir,
        auth2api_config_path,
        auth_config,
        interactive_tty,
        BACKENDS["claude"],
    )


