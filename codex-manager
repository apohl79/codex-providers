def toml_string(value: str) -> str:
    return json.dumps(value)


def sanitize_identifier(value: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9_-]+", "-", value.lower()).strip("-")
    return cleaned or "backend"


def strip_inline_comment(value: str) -> str:
    in_quote = False
    result = []
    for char in value:
        if char in ("'", '"'):
            in_quote = not in_quote
        if char == "#" and not in_quote:
            break
        result.append(char)
    return "".join(result).strip()


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def read_auth2api_config(path: Path) -> Auth2ApiConfig:
    host = "127.0.0.1"
    port = 8317
    auth_dir = "~/.auth2api"
    api_key: str | None = None
    in_api_keys = False

    if not path.exists():
        return Auth2ApiConfig(host=host, port=port, auth_dir=auth_dir, api_key=api_key)

    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("api-keys:"):
            parsed_keys = strip_inline_comment(line.split(":", 1)[1]).strip()
            if parsed_keys.startswith("[") and parsed_keys.endswith("]") and api_key is None:
                first_key = parsed_keys[1:-1].split(",", 1)[0].strip()
                if first_key:
                    api_key = unquote(first_key)
            in_api_keys = parsed_keys == ""
            continue
        if in_api_keys and line.startswith("-") and api_key is None:
            api_key = unquote(strip_inline_comment(line[1:].strip()))
            continue
        if ":" in line and not line.startswith("-"):
            in_api_keys = False
        if line.startswith("host:"):
            parsed = unquote(strip_inline_comment(line.split(":", 1)[1]))
            host = parsed if parsed and parsed != "0.0.0.0" else "127.0.0.1"
        if line.startswith("port:"):
            parsed = strip_inline_comment(line.split(":", 1)[1])
            if parsed.isdigit():
                port = int(parsed)
        if line.startswith("auth-dir:"):
            auth_dir = unquote(strip_inline_comment(line.split(":", 1)[1])) or auth_dir

    return Auth2ApiConfig(host=host, port=port, auth_dir=auth_dir, api_key=api_key)


def default_base_url(config: Auth2ApiConfig) -> str:
    return f"http://{config.host}:{config.port}/v1"


def normalize_base_url(value: str) -> str:
    trimmed = value.rstrip("/")
    return trimmed if trimmed.endswith("/v1") else f"{trimmed}/v1"


def resolve_auth_dir(value: str, repo_dir: Path) -> Path:
    expanded = Path(os.path.expanduser(value))
    return expanded if expanded.is_absolute() else (repo_dir / expanded).resolve()


def has_claude_login(auth_dir: Path) -> bool:
    return any(auth_dir.glob("claude-*.json"))


def insert_api_key(content: str, api_key: str) -> str:
    lines = content.splitlines()
    for index, line in enumerate(lines):
        stripped = line.strip()
        if not stripped.startswith("api-keys:"):
            continue
        indent = line[: len(line) - len(line.lstrip())]
        lines[index] = f"{indent}api-keys:"
        lines.insert(index + 1, f"{indent}  - {api_key}")
        return "\n".join(lines) + "\n"
    separator = "" if not content or content.endswith("\n") else "\n"
    return f"{content}{separator}api-keys:\n  - {api_key}\n"


def ensure_api_key(config_path: Path, dry_run: bool) -> tuple[Auth2ApiConfig, list[Path], bool]:
    config = read_auth2api_config(config_path)
    if config.api_key:
        return config, [], False
    if dry_run:
        return config, [], False

    api_key = f"sk-{secrets.token_hex(32)}"
    config_path.parent.mkdir(parents=True, exist_ok=True)
    existing = config_path.read_text() if config_path.exists() else "host: ''\nport: 8317\nauth-dir: ~/.auth2api\n"
    backup_path = backup(config_path)
    config_path.write_text(insert_api_key(existing, api_key))
    os.chmod(config_path, 0o600)
    backups = [backup_path] if backup_path else []
    return read_auth2api_config(config_path), backups, True


def run_claude_login(repo_dir: Path, config_path: Path, manual: bool) -> None:
    script = repo_dir / "dist" / "index.js"
    if not script.exists():
        subprocess.run(["npm", "run", "build"], cwd=repo_dir, check=True)
    command = [
        shutil.which("node") or "node",
        str(script),
        f"--config={config_path}",
        "--login",
        "--provider=anthropic",
    ]
    if manual:
        command.append("--manual")
    subprocess.run(command, cwd=repo_dir, check=True)


def read_toml(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError:
        return {}


def parse_providers(path: Path) -> dict[str, ProviderInfo]:
    data = read_toml(path)
    providers = data.get("model_providers", {})
    result: dict[str, ProviderInfo] = {}
    if not isinstance(providers, dict):
        return result
    for provider_id, value in providers.items():
        if not isinstance(value, dict):
            continue
        result[provider_id] = ProviderInfo(
            provider_id=provider_id,
            name=str(value.get("name", provider_id)),
            base_url=str(value.get("base_url", "")),
        )
    return result


def parse_context(path: Path) -> ContextInfo | None:
    data = read_toml(path)
    if not data:
        return None
    model = str(data.get("model", ""))
    provider_id = str(data.get("model_provider", ""))
    catalog = str(data.get("model_catalog_json", ""))
    catalog_path = Path(catalog).expanduser() if catalog else None
    try:
        context_window = int(data.get("model_context_window", DEFAULT_CONTEXT_WINDOW))
    except (TypeError, ValueError):
        context_window = DEFAULT_CONTEXT_WINDOW
    try:
        compact_limit = int(data.get("model_auto_compact_token_limit", DEFAULT_COMPACT_LIMIT))
    except (TypeError, ValueError):
        compact_limit = DEFAULT_COMPACT_LIMIT
    if not model and not provider_id:
        return None
    return ContextInfo(
        name=path.name.removesuffix(".config.toml"),
        path=path,
        model=model,
        provider_id=provider_id,
        catalog_path=catalog_path,
        context_window=context_window,
        compact_limit=compact_limit,
    )


def discover_contexts(codex_home: Path) -> list[ContextInfo]:
    contexts = []
    for path in sorted(codex_home.glob("*.config.toml")):
        context = parse_context(path)
        if context is not None:
            contexts.append(context)
    return contexts


def backend_provider_ids(backend: Backend) -> set[str]:
    return {sanitize_identifier(value) for value in (backend.default_provider, *backend.provider_aliases)}


def backend_context_names(backend: Backend) -> set[str]:
    return {sanitize_identifier(value) for value in (backend.default_context, *backend.context_aliases)}


def context_matches_backend(context: ContextInfo, backend: Backend) -> bool:
    provider_id = sanitize_identifier(context.provider_id) if context.provider_id else ""
    context_name = sanitize_identifier(context.name)
    return provider_id in backend_provider_ids(backend) or context_name in backend_context_names(backend)


def context_sort_key(context: ContextInfo, backend: Backend) -> tuple[int, str]:
    provider_id = sanitize_identifier(context.provider_id) if context.provider_id else ""
    context_name = sanitize_identifier(context.name)
    if context_name == backend.default_context and provider_id == backend.default_provider:
        rank = 0
    elif context_name == backend.default_context:
        rank = 1
    elif provider_id == backend.default_provider:
        rank = 2
    else:
        rank = 3
    return rank, context.name


def contexts_for_backend(contexts: list[ContextInfo], backend: Backend) -> list[ContextInfo]:
    matches = [context for context in contexts if context_matches_backend(context, backend)]
    return sorted(matches, key=lambda context: context_sort_key(context, backend))


def catalog_path_for_backend(codex_home: Path, backend: Backend) -> Path:
    return codex_home / f"{backend.default_context}-models.json"


def load_catalog(path: Path | None) -> dict:
    if path is None or not path.exists():
        return {"models": []}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return {"models": []}


def catalog_entries_by_slug(catalog: dict) -> dict[str, dict]:
    models = catalog.get("models", [])
    if not isinstance(models, list):
        return {}
    entries = {}
    for entry in models:
        if isinstance(entry, dict) and isinstance(entry.get("slug"), str):
            entries[entry["slug"]] = entry
            entries.setdefault(canonical_model(entry["slug"]), entry)
    return entries


def canonical_model(model: str) -> str:
    return CANONICAL_MODEL_ALIASES.get(model, model)


def normalize_models(models: list[str] | tuple[str, ...]) -> list[str]:
    seen: set[str] = set()
    result = []
    for model in models:
        normalized = canonical_model(model)
        if normalized not in seen:
            seen.add(normalized)
            result.append(normalized)
    return result


def model_identity(backend: Backend, slug: str) -> str:
    return f"{backend.label} model {slug}"


def adapt_instruction_text(text: str, backend: Backend, slug: str) -> str:
    identity = model_identity(backend, slug)
    updated = re.sub(
        r"You are Codex, a coding agent based on GPT-[^.\n]*\.",
        f"You are Codex, a coding agent running on {identity}.",
        text,
    )
    updated = re.sub(r"\bGPT-5(?:\.\d+)?\b", identity, updated)
    return re.sub(r"\bgpt-5(?:\.\d+)?\b", slug, updated)


def adapt_catalog_value(value: object, backend: Backend, slug: str) -> object:
    if isinstance(value, str):
        return adapt_instruction_text(value, backend, slug)
    if isinstance(value, list):
        return [adapt_catalog_value(item, backend, slug) for item in value]
    if isinstance(value, dict):
        return {key: adapt_catalog_value(item, backend, slug) for key, item in value.items()}
    return value


def adapt_catalog_entry(entry: dict, backend: Backend, slug: str) -> dict:
    return {
        key: adapt_catalog_value(value, backend, slug)
        for key, value in entry.items()
    }


def with_catalog_limits(entry: dict, context_window: int) -> dict:
    updated = dict(entry)
    updated.update(
        {
            "context_window": context_window,
            "max_context_window": context_window,
            "effective_context_window_percent": CATALOG_EFFECTIVE_CONTEXT_WINDOW_PERCENT,
        }
    )
    return updated


def fallback_model_entry(
    slug: str,
    backend: Backend,
    priority: int,
    template: dict | None,
    context_window: int,
) -> dict:
    entry = dict(template or {})
    entry.update(
        {
            "slug": slug,
            "display_name": slug,
            "description": f"{backend.label} model {slug}",
            "visibility": entry.get("visibility", "list"),
            "supported_in_api": entry.get("supported_in_api", True),
            "priority": priority,
        }
    )
    if "default_reasoning_level" not in entry:
        entry["default_reasoning_level"] = "medium"
    if "supported_reasoning_levels" not in entry:
        entry["supported_reasoning_levels"] = [
            {"effort": "low", "description": "Fast responses with lighter reasoning"},
            {"effort": "medium", "description": "Balances speed and reasoning depth"},
            {"effort": "high", "description": "Greater reasoning depth for complex tasks"},
        ]
    return adapt_catalog_entry(with_catalog_limits(entry, context_window), backend, slug)


def build_catalog(
    selected_models: tuple[str, ...],
    backend: Backend,
    source_catalog: dict,
    context_window: int,
) -> dict:
    by_slug = catalog_entries_by_slug(source_catalog)
    template = next(iter(by_slug.values()), None)
    entries = []
    for index, model in enumerate(selected_models, start=1):
        if model in by_slug:
            entry = dict(by_slug[model])
            entry.update(
                {
                    "slug": model,
                    "display_name": model,
                    "description": f"{backend.label} model {model}",
                    "priority": index,
                }
            )
            entries.append(adapt_catalog_entry(with_catalog_limits(entry, context_window), backend, model))
        else:
            entries.append(fallback_model_entry(model, backend, index, template, context_window))
    return {"models": entries}


def model_matches_backend(model: str, backend: Backend) -> bool:
    return (
        model.startswith("claude-")
        or model.startswith("opus-")
        or model.startswith("sonnet-")
        or model.startswith("haiku-")
    )


def filter_models(models: list[str], backend: Backend) -> list[str]:
    seen: set[str] = set()
    result = []
    for model in models:
        normalized = canonical_model(model)
        if model_matches_backend(normalized, backend) and normalized not in seen:
            seen.add(normalized)
            result.append(normalized)
    return result


def fetch_models(base_url: str, api_key: str | None, backend: Backend) -> tuple[list[str], str]:
    url = f"{base_url.rstrip('/')}/models"
    request = urllib.request.Request(url)
    if api_key:
        request.add_header("Authorization", f"Bearer {api_key}")
        request.add_header("x-api-key", api_key)
    try:
        with urllib.request.urlopen(request, timeout=2) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
        return list(backend.fallback_models), f"Using fallback models; /v1/models was unavailable ({error})."

    data = payload.get("data", [])
    models = [
        item.get("id")
        for item in data
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    ]
    filtered = filter_models(models, backend)
    if filtered:
        return normalize_models(filtered), f"Fetched {len(filtered)} {backend.label} models from the local server."
    return list(backend.fallback_models), "Using fallback models; the local server returned no matching models."


def remove_provider_blocks(content: str, provider_id: str) -> str:
    names = {f"model_providers.{provider_id}", f"model_providers.{provider_id}.auth"}
    output = []
    skip = False
    for line in content.splitlines():
        match = re.match(r"^\[([^\]]+)\]\s*$", line)
        if match:
            skip = match.group(1) in names
        if not skip:
            output.append(line)
    return "\n".join(output).rstrip()


def provider_block(draft: Draft, repo_dir: Path, auth2api_config: Path) -> str:
    node = shutil.which("node") or "node"
    auth_command = " ".join(
        [
            "const fs = require('fs');",
            "const yaml = require('js-yaml');",
            f"const cfg = yaml.load(fs.readFileSync({json.dumps(str(auth2api_config))}, 'utf8'));",
            "const key = cfg?.['api-keys']?.[0];",
            "if (!key) process.exit(1);",
            "process.stdout.write(key);",
        ]
    )
    args = json.dumps(["-e", auth_command])
    return f"""
[model_providers.{draft.provider_id}]
name = {toml_string(draft.display_name)}
base_url = {toml_string(draft.base_url)}
wire_api = "responses"
requires_openai_auth = false
supports_websockets = false
stream_idle_timeout_ms = 600000

[model_providers.{draft.provider_id}.auth]
command = {toml_string(node)}
args = {args}
cwd = {toml_string(str(repo_dir))}
timeout_ms = 5000
refresh_interval_ms = 300000
""".strip()


def context_content(draft: Draft) -> str:
    return "\n".join(
        [
            f"model = {toml_string(draft.default_model)}",
            f"model_provider = {toml_string(draft.provider_id)}",
            f"model_catalog_json = {toml_string(str(draft.catalog_path))}",
            f"model_context_window = {draft.context_window}",
            f"model_auto_compact_token_limit = {draft.compact_limit}",
            "",
        ]
    )


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    target = path.with_name(f"{path.name}.bak-codex-manager-{time.strftime('%Y%m%d%H%M%S')}")
    shutil.copy2(path, target)
    return target


def write_files(
    draft: Draft,
    codex_config: Path,
    repo_dir: Path,
    auth2api_config: Path,
    source_catalog: dict,
) -> list[Path]:
    backups = [path for path in (backup(codex_config), backup(draft.context_path), backup(draft.catalog_path)) if path]
    codex_config.parent.mkdir(parents=True, exist_ok=True)
    draft.context_path.parent.mkdir(parents=True, exist_ok=True)
    existing_config = codex_config.read_text() if codex_config.exists() else ""
    next_config = f"{remove_provider_blocks(existing_config, draft.provider_id)}\n\n{provider_block(draft, repo_dir, auth2api_config)}\n"
    catalog = build_catalog(draft.selected_models, draft.backend, source_catalog, draft.context_window)
    codex_config.write_text(next_config)
    draft.context_path.write_text(context_content(draft))
    draft.catalog_path.write_text(json.dumps(catalog, indent=2) + "\n")
    os.chmod(codex_config, 0o600)
    os.chmod(draft.context_path, 0o600)
    os.chmod(draft.catalog_path, 0o600)
    return backups


class CursesUi:
    def __init__(self, stdscr: curses.window) -> None:
        self.stdscr = stdscr
        curses.curs_set(0)
        self.stdscr.keypad(True)
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(3, curses.COLOR_YELLOW, -1)

    def color(self, pair: int) -> int:
        return curses.color_pair(pair) if curses.has_colors() else 0

    def add(self, y: int, x: int, text: str, attr: int = 0) -> None:
        height, width = self.stdscr.getmaxyx()
        if y < 0 or y >= height or x >= width:
            return
        self.stdscr.addnstr(y, x, text, max(0, width - x - 1), attr)

    def frame(self, title: str, subtitle: str) -> None:
        self.stdscr.erase()
        height, width = self.stdscr.getmaxyx()
        self.stdscr.border()
        self.add(0, 2, f" {title} ", self.color(1) | curses.A_BOLD)
        self.add(2, 3, subtitle)
        self.add(height - 2, 3, "↑/↓ move  Space toggle  Enter continue  q quit", self.color(3))

    def menu(self, title: str, subtitle: str, items: list[tuple[str, str]], default: int = 0) -> int:
        selected = default
        while True:
            self.frame(title, subtitle)
            y = 4
            for index, (label, description) in enumerate(items):
                attr = self.color(2) | curses.A_BOLD if index == selected else curses.A_NORMAL
                self.add(y, 5, f"{index + 1}. {label}", attr)
                self.add(y + 1, 8, description)
                y += 3
            key = self.stdscr.getch()
            if key in (curses.KEY_UP, ord("k")):
                selected = (selected - 1) % len(items)
            elif key in (curses.KEY_DOWN, ord("j")):
                selected = (selected + 1) % len(items)
            elif key in (10, 13):
                return selected
            elif ord("1") <= key <= ord("9"):
                number = key - ord("1")
                if number < len(items):
                    return number
            elif key in (ord("q"), 27):
                raise KeyboardInterrupt

    def multi_select(
        self,
        title: str,
        subtitle: str,
        items: list[str],
        selected: set[int],
    ) -> set[int]:
        cursor = 0
        offset = 0
        while True:
            self.frame(title, subtitle)
            height, _ = self.stdscr.getmaxyx()
            page_size = max(4, height - 9)
            if cursor < offset:
                offset = cursor
            if cursor >= offset + page_size:
                offset = cursor - page_size + 1
            visible = items[offset : offset + page_size]
            for row, item in enumerate(visible):
                index = offset + row
                mark = "[x]" if index in selected else "[ ]"
                attr = self.color(2) | curses.A_BOLD if index == cursor else curses.A_NORMAL
                self.add(4 + row, 5, f"{mark} {item}", attr)
            self.add(height - 3, 3, f"Selected {len(selected)} of {len(items)}. a all, n none, Space toggle")
            key = self.stdscr.getch()
            if key in (curses.KEY_UP, ord("k")):
                cursor = (cursor - 1) % len(items)
            elif key in (curses.KEY_DOWN, ord("j")):
                cursor = (cursor + 1) % len(items)
            elif key == ord(" "):
                if cursor in selected:
                    selected.remove(cursor)
                else:
                    selected.add(cursor)
            elif key == ord("a"):
                selected = set(range(len(items)))
            elif key == ord("n"):
                selected = set()
            elif key in (10, 13):
                if selected:
                    return selected
            elif key in (ord("q"), 27):
                raise KeyboardInterrupt

    def message(self, title: str, lines: list[str]) -> None:
        self.frame(title, "Press Enter to continue.")
        for index, line in enumerate(lines):
            self.add(4 + index, 5, line)
        while self.stdscr.getch() not in (10, 13):
            pass


def choose_missing_login_action(auth_dir: Path) -> int:
    def run(stdscr: curses.window) -> int:
        ui = CursesUi(stdscr)
        return ui.menu(
            "Claude Login",
            f"No Claude token file was found in {auth_dir}.",
            [
                (
                    "Run Claude login now",
                    "Opens the auth2api Claude OAuth flow, stores the token, and reloads the running server.",
                ),
                (
                    "Configure Codex only",
                    "Writes Codex config now. Requests will fail until a Claude login is added.",
                ),
                ("Abort", "Exit without changing Codex config."),
            ],
            0,
        )

    return curses.wrapper(run)


def ensure_claude_login(
    args: argparse.Namespace,
    repo_dir: Path,
    auth2api_config_path: Path,
    auth_config: Auth2ApiConfig,
    interactive_tty: bool,
) -> None:
    if args.skip_login_check:
        return

    auth_dir = resolve_auth_dir(auth_config.auth_dir, repo_dir)
    if has_claude_login(auth_dir):
        return

    if args.dry_run:
        print(f"Would run Claude login: no claude-*.json token file exists in {auth_dir}")
        return

    if args.yes:
        if not interactive_tty:
            raise SystemExit(
                f"Error: no Claude login found in {auth_dir}. Run codex-manager from a terminal or pass --skip-login-check."
            )
        print(f"No Claude login found in {auth_dir}. Starting Claude login.")
        run_claude_login(repo_dir, auth2api_config_path, args.manual_login)
    elif interactive_tty:
        choice = choose_missing_login_action(auth_dir)
        if choice == 1:
            return
        if choice == 2:
            raise KeyboardInterrupt
        run_claude_login(repo_dir, auth2api_config_path, args.manual_login)
    else:
        raise SystemExit(
            f"Error: no Claude login found in {auth_dir}. Run codex-manager from a terminal or pass --skip-login-check."
        )

    if not has_claude_login(auth_dir):
        raise SystemExit(f"Error: Claude login completed but no claude-*.json token file exists in {auth_dir}.")


def choose_draft(
    ui: CursesUi,
    args: argparse.Namespace,
    codex_home: Path,
    codex_config: Path,
    repo_dir: Path,
    auth2api_config_path: Path,
) -> tuple[Draft, dict]:
    auth_config = read_auth2api_config(auth2api_config_path)
    providers = parse_providers(codex_config)
    contexts = discover_contexts(codex_home)
    source_context = parse_context(Path(args.source_context).expanduser()) if args.source_context else None

    backend = BACKENDS["claude"]
    matching_contexts = contexts_for_backend(contexts, backend)
    if len(matching_contexts) > 1:
        context_choice = ui.menu(
            f"{backend.label} Context",
            f"More than one Codex context looks like it belongs to {backend.label}. Choose the one this provider should own.",
            [
                (
                    context.name,
                    f"Provider: {context.provider_id or 'none'}; model: {context.model or 'none'}; file: {context.path}",
                )
                for context in matching_contexts
            ],
            0,
        )
        existing = matching_contexts[context_choice]
    else:
        existing = matching_contexts[0] if matching_contexts else None

    if existing:
        context_name = existing.name
        provider_id = existing.provider_id or sanitize_identifier(existing.name)
        display_name = providers.get(provider_id, ProviderInfo(provider_id, backend.display_name, "")).name
        context_window = existing.context_window
        compact_limit = existing.compact_limit
    else:
        context_name = backend.default_context
        provider_id = backend.default_provider
        display_name = args.display_name or backend.display_name
        context_window = int(args.context_window or (source_context.context_window if source_context else DEFAULT_CONTEXT_WINDOW))
        compact_limit = int(args.compact_limit or (source_context.compact_limit if source_context else DEFAULT_COMPACT_LIMIT))

    base_url = normalize_base_url(default_base_url(auth_config))

    models, model_source = fetch_models(base_url, auth_config.api_key, backend)
    seed_context = existing or source_context
    if seed_context and seed_context.model:
        seed_model = canonical_model(seed_context.model)
        if model_matches_backend(seed_model, backend) and seed_model not in models:
            models = [seed_model, *models]

    selected_indexes = ui.multi_select(
        "Models",
        f"Choose models to add to this context. Default is all available. {model_source}",
        models,
        set(range(len(models))),
    )
    selected_models = tuple(normalize_models(tuple(models[index] for index in sorted(selected_indexes))))

    default_index = ui.menu(
        "Default Model",
        "Codex uses this model when the context starts without an explicit model override.",
        [(model, "Included in the generated model catalog.") for model in selected_models],
        0,
    )
    default_model = selected_models[default_index]

    budget_choice = ui.menu(
        "Token Budget",
        "Context window is the total usable token budget. Preset auto-compact thresholds are 95% of that window.",
        [
            ("Keep current limits", f"Context window: {context_window} tokens. Auto-compact threshold: {compact_limit} tokens."),
            ("Claude 1M context", "Context window: 1000000 tokens. Auto-compact threshold: 950000 tokens."),
            ("Recommended Claude context", "Context window: 400000 tokens. Auto-compact threshold: 380000 tokens."),
            ("Small Claude context", "Context window: 200000 tokens. Auto-compact threshold: 190000 tokens."),
            ("Tiny Claude context", "Context window: 128000 tokens. Auto-compact threshold: 121600 tokens."),
        ],
        0,
    )
    if budget_choice == 1:
        context_window, compact_limit = 1000000, 950000
    if budget_choice == 2:
        context_window, compact_limit = 400000, 380000
    if budget_choice == 3:
        context_window, compact_limit = 200000, 190000
    if budget_choice == 4:
        context_window, compact_limit = 128000, 121600

    context_name = sanitize_identifier(context_name)
    provider_id = sanitize_identifier(provider_id)
    context_path = codex_home / f"{context_name}.config.toml"
    catalog_path = catalog_path_for_backend(codex_home, backend)
    draft = Draft(
        context_name=context_name,
        context_path=context_path,
        provider_id=provider_id,
        display_name=display_name,
        backend=backend,
        base_url=base_url,
        selected_models=selected_models,
        default_model=default_model,
        context_window=context_window,
        compact_limit=compact_limit,
        catalog_path=catalog_path,
        dry_run=False,
    )

    summary = [
        ("Write files now", "Back up existing files, then write the provider, context, and model catalog."),
        ("Preview only", "Show the selected paths and values without changing files."),
        ("Abort", "Exit without writing anything."),
    ]
    action = ui.menu("Summary", summary_text(draft, codex_config), summary, 0)
    if action == 1:
        draft = replace(draft, dry_run=True)
    if action == 2:
        raise KeyboardInterrupt

    catalog_source_context = existing or source_context
    source_catalog = load_catalog(catalog_source_context.catalog_path if catalog_source_context else None)
    return draft, source_catalog


def summary_text(draft: Draft, codex_config: Path) -> str:
    return (
        f"{draft.backend.label} provider {draft.provider_id}; context {draft.context_name}; "
        f"{len(draft.selected_models)} models; default {draft.default_model}; "
        f"endpoint {draft.base_url}; config {codex_config}"
    )


def noninteractive_draft(
    args: argparse.Namespace,
    codex_home: Path,
    auth2api_config_path: Path,
) -> tuple[Draft, dict]:
    preset = (args.preset or "claude").lower()
    if preset != "claude":
        raise SystemExit("Error: only the claude preset is supported.")
    backend = BACKENDS["claude"]
    auth_config = read_auth2api_config(auth2api_config_path)
    base_url = normalize_base_url(default_base_url(auth_config))
    models, _ = fetch_models(base_url, auth_config.api_key, backend)
    if args.models:
        selected_models = tuple(normalize_models(tuple(item.strip() for item in args.models.split(",") if item.strip())))
    else:
        selected_models = tuple(normalize_models(tuple(models)))
    default_model = canonical_model(args.model or selected_models[0])
    if default_model not in selected_models:
        selected_models = (default_model, *selected_models)
    existing = None
    matching_contexts = contexts_for_backend(discover_contexts(codex_home), backend)
    existing = matching_contexts[0] if matching_contexts else None
    source_context = parse_context(Path(args.source_context).expanduser()) if args.source_context else None
    catalog_source_context = existing or source_context
    source_catalog = load_catalog(catalog_source_context.catalog_path if catalog_source_context else None)
    context_name = sanitize_identifier(existing.name if existing else backend.default_context)
    provider_id = sanitize_identifier(existing.provider_id if existing and existing.provider_id else backend.default_provider)
    context_window = int(args.context_window or (catalog_source_context.context_window if catalog_source_context else DEFAULT_CONTEXT_WINDOW))
    compact_limit = int(args.compact_limit or (catalog_source_context.compact_limit if catalog_source_context else DEFAULT_COMPACT_LIMIT))
    catalog_path = catalog_path_for_backend(codex_home, backend)
    return (
        Draft(
            context_name=context_name,
            context_path=codex_home / f"{context_name}.config.toml",
            provider_id=provider_id,
            display_name=args.display_name or backend.display_name,
            backend=backend,
            base_url=base_url,
            selected_models=selected_models,
            default_model=default_model,
            context_window=context_window,
            compact_limit=compact_limit,
            catalog_path=catalog_path,
            dry_run=bool(args.dry_run),
        ),
        source_catalog,
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="codex-manager", description="Manage Codex contexts.")
    parser.add_argument("--preset", help=argparse.SUPPRESS)
    parser.add_argument("--context", help=argparse.SUPPRESS)
    parser.add_argument("--provider", help=argparse.SUPPRESS)
    parser.add_argument("--display-name", help="Provider display name.")
    parser.add_argument("--model", help="Default model for the context.")
    parser.add_argument("--models", help="Comma-separated models to include. Defaults to all available.")
    parser.add_argument("--context-window", type=int, help="Codex model_context_window value.")
    parser.add_argument("--compact-limit", type=int, help="Codex model_auto_compact_token_limit value.")
    parser.add_argument("--codex-home", default=os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    parser.add_argument("--codex-config", default=os.environ.get("CODEX_CONFIG"))
    parser.add_argument(
        "--server-config",
        dest="auth2api_config",
        metavar="SERVER_CONFIG",
        default=os.environ.get("AUTH2API_CONFIG_PATH"),
        help="Server config file path.",
    )
    parser.add_argument("--auth2api-config", dest="auth2api_config", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    parser.add_argument("--source-context", default=os.environ.get("AUTH2API_SOURCE_CONTEXT"))
    parser.add_argument("--yes", action="store_true", help="Run non-interactively with defaults.")
    parser.add_argument("--dry-run", action="store_true", help="Preview writes without changing files.")
    parser.add_argument("--manual-login", action="store_true", help="Use manual callback URL paste when running Claude login.")
    parser.add_argument(
        "--skip-login-check",
        action="store_true",
        help="Write Codex config even if no Claude login token is present.",
    )
    args = parser.parse_args()
    if args.preset and args.preset.lower() != "claude":
        parser.error("only the claude preset is supported.")
    if args.context or args.provider:
        parser.error("--context and --provider are no longer supported.")
    return args


def main() -> int:
    args = parse_args()
    repo_dir = Path(__file__).resolve().parent
    codex_home = Path(args.codex_home).expanduser()
    codex_config = Path(args.codex_config).expanduser() if args.codex_config else codex_home / "config.toml"
    auth2api_config = Path(args.auth2api_config).expanduser() if args.auth2api_config else repo_dir / "config.yaml"
    if not args.source_context:
        args.source_context = str(codex_home / "claude.config.toml")

    interactive_tty = sys.stdin.isatty() and sys.stdout.isatty()
    auth_config = read_auth2api_config(auth2api_config)
    try:
        ensure_claude_login(args, repo_dir, auth2api_config, auth_config, interactive_tty)
    except KeyboardInterrupt:
        print("Aborted.")
        return 0

    auth_config, server_config_backups, server_config_changed = ensure_api_key(auth2api_config, args.dry_run)

    if args.yes or not interactive_tty:
        draft, source_catalog = noninteractive_draft(args, codex_home, auth2api_config)
    else:
        def run(stdscr: curses.window) -> tuple[Draft, dict]:
            return choose_draft(CursesUi(stdscr), args, codex_home, codex_config, repo_dir, auth2api_config)

        try:
            draft, source_catalog = curses.wrapper(run)
        except KeyboardInterrupt:
            print("Aborted.")
            return 0

    if draft.dry_run:
        if not auth_config.api_key:
            print(f"Would create local server API key in: {auth2api_config}")
        print(f"Would update Codex config: {codex_config}")
        print(f"Would update context: {draft.context_path}")
        print(f"Would update model catalog: {draft.catalog_path}")
        print(f"Provider: {draft.provider_id} ({draft.display_name})")
        print(f"Models: {', '.join(draft.selected_models)}")
        return 0

    backups = write_files(draft, codex_config, repo_dir, auth2api_config, source_catalog)
    if server_config_changed:
        print(f"Updated server API key config: {auth2api_config}")
        if server_config_backups:
            print("Server config backups:")
            for path in server_config_backups:
                print(f"  {path}")
    print(f"Updated Codex provider: {draft.provider_id}")
    print(f"Updated Codex config: {codex_config}")
    print(f"Updated context file: {draft.context_path}")
    print(f"Updated model catalog: {draft.catalog_path}")
    if backups:
        print("Backups:")
        for path in backups:
            print(f"  {path}")
    print(f"Use with: codex -p {draft.context_name}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
