def toml_string(value: str) -> str:
    return json.dumps(value)


def sanitize_identifier(value: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9_-]+", "-", value.lower()).strip("-")
    return cleaned or "backend"


def strip_inline_comment(value: str) -> str:
    in_quote = False
    result = []
    for char in value:
        if char in ("'", '"'):
            in_quote = not in_quote
        if char == "#" and not in_quote:
            break
        result.append(char)
    return "".join(result).strip()


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def read_auth2api_config(path: Path) -> Auth2ApiConfig:
    host = "127.0.0.1"
    port = 8317
    auth_dir = "~/.auth2api"
    api_key: str | None = None
    deepseek_api_key_env = "DEEPSEEK_API_KEY"
    in_api_keys = False
    in_deepseek = False

    if not path.exists():
        return Auth2ApiConfig(
            host=host,
            port=port,
            auth_dir=auth_dir,
            api_key=api_key,
            deepseek_api_key_env=deepseek_api_key_env,
        )

    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        indent = len(raw_line) - len(raw_line.lstrip())
        if not line or line.startswith("#"):
            continue
        if line == "deepseek:" and indent == 0:
            in_deepseek = True
            in_api_keys = False
            continue
        if in_deepseek and indent == 0:
            in_deepseek = False
        if in_deepseek and line.startswith("api-key-env:"):
            parsed = unquote(strip_inline_comment(line.split(":", 1)[1]))
            if parsed:
                deepseek_api_key_env = parsed
            continue
        if line.startswith("api-keys:"):
            parsed_keys = strip_inline_comment(line.split(":", 1)[1]).strip()
            if parsed_keys.startswith("[") and parsed_keys.endswith("]") and api_key is None:
                first_key = parsed_keys[1:-1].split(",", 1)[0].strip()
                if first_key:
                    api_key = unquote(first_key)
            in_api_keys = parsed_keys == ""
            continue
        if in_api_keys and line.startswith("-") and api_key is None:
            api_key = unquote(strip_inline_comment(line[1:].strip()))
            continue
        if ":" in line and not line.startswith("-"):
            in_api_keys = False
        if line.startswith("host:"):
            parsed = unquote(strip_inline_comment(line.split(":", 1)[1]))
            host = parsed if parsed and parsed != "0.0.0.0" else "127.0.0.1"
        if line.startswith("port:"):
            parsed = strip_inline_comment(line.split(":", 1)[1])
            if parsed.isdigit():
                port = int(parsed)
        if line.startswith("auth-dir:"):
            auth_dir = unquote(strip_inline_comment(line.split(":", 1)[1])) or auth_dir

    return Auth2ApiConfig(
        host=host,
        port=port,
        auth_dir=auth_dir,
        api_key=api_key,
        deepseek_api_key_env=deepseek_api_key_env,
    )


def default_base_url(config: Auth2ApiConfig) -> str:
    return f"http://{config.host}:{config.port}/v1"


def normalize_base_url(value: str) -> str:
    trimmed = value.rstrip("/")
    return trimmed if trimmed.endswith("/v1") else f"{trimmed}/v1"


def resolve_auth_dir(value: str, repo_dir: Path) -> Path:
    expanded = Path(os.path.expanduser(value))
    return expanded if expanded.is_absolute() else (repo_dir / expanded).resolve()


def has_claude_login(auth_dir: Path) -> bool:
    return any(auth_dir.glob("claude-*.json"))


def has_deepseek_login(auth_dir: Path, api_key_env: str) -> bool:
    return any(auth_dir.glob("deepseek-*.json")) or bool(os.environ.get(api_key_env, "").strip())


def provider_has_configuration(
    backend: Backend,
    auth_dir: Path,
    api_key_env: str,
    codex_home: Path,
    codex_config: Path,
) -> bool:
    if backend.key == "deepseek":
        has_credential = has_deepseek_login(auth_dir, api_key_env)
    else:
        has_credential = has_claude_login(auth_dir)
    if has_credential:
        return True

    if any(
        context.provider_id in backend.provider_aliases
        or context.name in backend.context_aliases
        for context in discover_contexts(codex_home)
    ):
        return True
    return backend.default_provider in parse_providers(codex_config)


