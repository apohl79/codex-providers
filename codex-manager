def insert_api_key(content: str, api_key: str) -> str:
    lines = content.splitlines()
    for index, line in enumerate(lines):
        stripped = line.strip()
        if not stripped.startswith("api-keys:"):
            continue
        indent = line[: len(line) - len(line.lstrip())]
        lines[index] = f"{indent}api-keys:"
        lines.insert(index + 1, f"{indent}  - {api_key}")
        return "\n".join(lines) + "\n"
    separator = "" if not content or content.endswith("\n") else "\n"
    return f"{content}{separator}api-keys:\n  - {api_key}\n"


def ensure_api_key(config_path: Path, dry_run: bool) -> tuple[Auth2ApiConfig, list[Path], bool]:
    config = read_auth2api_config(config_path)
    if config.api_key:
        return config, [], False
    if dry_run:
        return config, [], False

    api_key = f"sk-{secrets.token_hex(32)}"
    config_path.parent.mkdir(parents=True, exist_ok=True)
    existing = config_path.read_text() if config_path.exists() else "host: ''\nport: 8317\nauth-dir: ~/.auth2api\n"
    backup_path = backup(config_path)
    config_path.write_text(insert_api_key(existing, api_key))
    os.chmod(config_path, 0o600)
    backups = [backup_path] if backup_path else []
    return read_auth2api_config(config_path), backups, True


def ensure_node_dependencies(repo_dir: Path) -> None:
    dependency_check = subprocess.run(
        ["npm", "ls", "--depth=0"],
        cwd=repo_dir,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if dependency_check.returncode != 0:
        subprocess.run(["npm", "install"], cwd=repo_dir, check=True)


def run_provider_login(repo_dir: Path, config_path: Path, provider_id: str, manual: bool) -> None:
    script = repo_dir / "dist" / "index.js"
    ensure_node_dependencies(repo_dir)
    if not script.exists():
        subprocess.run(["npm", "run", "build"], cwd=repo_dir, check=True)
    command = [
        shutil.which("node") or "node",
        str(script),
        f"--config={config_path}",
        "--login",
        f"--provider={provider_id}",
    ]
    if manual:
        command.append("--manual")
    subprocess.run(command, cwd=repo_dir, check=True)


def run_claude_login(repo_dir: Path, config_path: Path, manual: bool) -> None:
    run_provider_login(repo_dir, config_path, "anthropic", manual)


def run_deepseek_login(repo_dir: Path, config_path: Path) -> None:
    run_provider_login(repo_dir, config_path, "deepseek", False)


def read_toml(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError:
        return {}


def parse_providers(path: Path) -> dict[str, ProviderInfo]:
    data = read_toml(path)
    providers = data.get("model_providers", {})
    result: dict[str, ProviderInfo] = {}
    if not isinstance(providers, dict):
        return result
    for provider_id, value in providers.items():
        if not isinstance(value, dict):
            continue
        result[provider_id] = ProviderInfo(
            provider_id=provider_id,
            name=str(value.get("name", provider_id)),
            base_url=str(value.get("base_url", "")),
        )
    return result


def parse_context(path: Path) -> ContextInfo | None:
    data = read_toml(path)
    if not data:
        return None
    model = str(data.get("model", ""))
    provider_id = str(data.get("model_provider", ""))
    catalog = str(data.get("model_catalog_json", ""))
    catalog_path = Path(catalog).expanduser() if catalog else None
    try:
        context_window = int(data.get("model_context_window", DEFAULT_CONTEXT_WINDOW))
    except (TypeError, ValueError):
        context_window = DEFAULT_CONTEXT_WINDOW
    try:
        compact_limit = int(data.get("model_auto_compact_token_limit", DEFAULT_COMPACT_LIMIT))
    except (TypeError, ValueError):
        compact_limit = DEFAULT_COMPACT_LIMIT
    if not model and not provider_id:
        return None
    return ContextInfo(
        name=path.name.removesuffix(".config.toml"),
        path=path,
        model=model,
        provider_id=provider_id,
        catalog_path=catalog_path,
        context_window=context_window,
        compact_limit=compact_limit,
    )


def parse_multi_agent_v2_threads(path: Path) -> int:
    if not path.exists():
        return DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError:
        return DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    features = data.get("features", {})
    if not isinstance(features, dict):
        return DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    multi_agent_v2 = features.get("multi_agent_v2", {})
    if not isinstance(multi_agent_v2, dict):
        return DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    value = multi_agent_v2.get("max_concurrent_threads_per_session")
    return (
        value
        if isinstance(value, int) and not isinstance(value, bool) and value > 0
        else DEFAULT_MAX_CONCURRENT_THREADS_PER_SESSION
    )


def positive_int(value: str) -> int:
    parsed = int(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def discover_contexts(codex_home: Path) -> list[ContextInfo]:
    contexts = []
    for path in sorted(codex_home.glob("*.config.toml")):
        context = parse_context(path)
        if context is not None:
            contexts.append(context)
    return contexts


def backend_provider_ids(backend: Backend) -> set[str]:
    return {sanitize_identifier(value) for value in (backend.default_provider, *backend.provider_aliases)}


def backend_context_names(backend: Backend) -> set[str]:
    return {sanitize_identifier(value) for value in (backend.default_context, *backend.context_aliases)}


def context_matches_backend(context: ContextInfo, backend: Backend) -> bool:
    provider_id = sanitize_identifier(context.provider_id) if context.provider_id else ""
    context_name = sanitize_identifier(context.name)
    return provider_id in backend_provider_ids(backend) or context_name in backend_context_names(backend)


def context_sort_key(context: ContextInfo, backend: Backend) -> tuple[int, str]:
    provider_id = sanitize_identifier(context.provider_id) if context.provider_id else ""
    context_name = sanitize_identifier(context.name)
    if context_name == backend.default_context and provider_id == backend.default_provider:
        rank = 0
    elif context_name == backend.default_context:
        rank = 1
    elif provider_id == backend.default_provider:
        rank = 2
    else:
        rank = 3
    return rank, context.name


def contexts_for_backend(contexts: list[ContextInfo], backend: Backend) -> list[ContextInfo]:
    matches = [context for context in contexts if context_matches_backend(context, backend)]
    return sorted(matches, key=lambda context: context_sort_key(context, backend))


def catalog_path_for_backend(codex_home: Path, backend: Backend) -> Path:
